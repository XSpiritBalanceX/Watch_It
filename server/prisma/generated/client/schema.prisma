generator client {
  provider = "prisma-client-js"
  output   = "generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  email    String  @unique
  name     String?
  password String

  watchedItems  WatchedItem[]
  toWatchItems  ToWatchItem[]
  watchingItems WatchingItem[]

  @@map("user")
}

model WatchedItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  title       String
  type        String
  director    String?
  releaseYear Int?    @map("release_year")

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  @@map("watched_item")
}

model ToWatchItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  title       String
  type        String
  director    String?
  releaseYear Int?    @map("release_year")

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  @@map("to_watch_item")
}

model WatchingItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  title       String
  type        String
  director    String?
  releaseYear Int?    @map("release_year")

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  @@map("watching_item")
}
